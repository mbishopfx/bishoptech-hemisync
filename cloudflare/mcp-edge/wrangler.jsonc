{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cognistration-mcp-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "UPSTREAM_MCP_ENDPOINT": "https://cognistration.com/api/mcp",
    "CORS_ALLOWED_ORIGINS": "https://cognistration.com,https://www.cognistration.com,https://chatgpt.com,https://www.chatgpt.com,https://chat.openai.com"
  }
}
